# ---------------------------------------------------------------------
# 11. ЧТО НАДО ОСТАВИТЬ В РЕПОЗИТОРИИ ЯВНО (исключения ставим В КОНЦЕ)
# ---------------------------------------------------------------------
# Пустые папки git не хранит; чтобы сохранить структуру, кладут .gitkeep
!.gitkeep
!.gitattributes
!.gitignore
!.editorconfig
!.pre-commit-config.yaml
!.github/
!.env.example
!requirements.txt
!requirements-*.txt
!pyproject.toml
!Dockerfile
!docker-compose.yml
!docker-compose.yaml
!README.md
!LICENSE

# Примеры данных / фикстуры для тестов, если они нужны репозиторию
!tests/**/*.db
!tests/fixtures/
!examples/**/*.db
