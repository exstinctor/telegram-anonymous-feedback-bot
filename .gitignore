# =====================================================================
# .gitignore — Python / Telegram-бот (aiogram) и всё, что рядом
# Порядок правил важен: более поздние правила перекрывают ранние.
# =====================================================================


# ---------------------------------------------------------------------
# 1. СЕКРЕТЫ И КОНФИГИ С ДАННЫМИ  (самое важное для публичного репо!)
# ---------------------------------------------------------------------
# Переменные окружения с токеном бота, ключами API и т.п.
.env
.env.*
*.env
# Шаблон без значений — его как раз НУЖНО коммитить
!.env.example
!.env.sample
!.env.template

# Локальные конфиги с реальными значениями
config.local.py
config.local.json
config.local.yaml
config.local.yml
settings.local.py
secrets.py
secrets.json
secrets.yaml
secrets.yml
credentials.json
service-account*.json

# Ключи, сертификаты, сертификаты TLS
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
*.ppk

# Токены и сессии (Telethon / Pyrogram / прочие клиенты)
*.session
*.session-journal
*.session.sqlite
*.token

# Менеджеры секретов и шифрованные файлы
.secrets/
.vault/
*.gpg
*.asc
.htpasswd


# ---------------------------------------------------------------------
# 2. БАЗЫ ДАННЫХ И ПОЛЬЗОВАТЕЛЬСКИЕ ДАННЫЕ БОТА
#    (bot_database.db, premium_users.db и т.п. содержат данные людей)
# ---------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.sql.gz
*.dump
*.rdb
*.aof

# Директории с данными и бэкапами
backups/
backup/
*.bak
*.backup
*.old
*.orig
*.rej
*.sav

# Загруженные пользователями файлы, кэш медиа
uploads/
tmp/
temp/
.tmp/
*.tmp
*.temp


