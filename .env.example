# Скопируйте этот файл в .env и заполните реальными значениями.
# .env НЕ должен коммититься в git (уже добавлен в .gitignore).

# Токен бота, полученный от @BotFather
BOT_TOKEN=

# Ваш Telegram user ID (числом) — только этот аккаунт получает доступ к /admin
MAIN_ADMIN_ID=

# Необязательно: каталог для файлов БД (bot_database.db, premium_users.db).
# По умолчанию — текущая папка. В Docker выставляется в docker-compose.yml.
DATA_DIR=

# Необязательно: минимальный интервал (в секундах) между анонимными
# сообщениями/ответами одного пользователя. По умолчанию 3.
MESSAGE_COOLDOWN_SECONDS=

# Необязательно: адрес Redis для хранения состояний FSM (ожидание кастомной
# ссылки, ввод дней премиума и т.п.). Без этой переменной состояния хранятся
# в памяти процесса и теряются при перезапуске бота — с Redis переживают.
# Пример: redis://localhost:6379/0 (в Docker Compose — redis://redis:6379/0)
REDIS_URL=

# Необязательно: DSN проекта в Sentry — ошибки бота будут дублироваться туда
# в дополнение к обычным логам. Без переменной ничего никуда не отправляется.
SENTRY_DSN=
